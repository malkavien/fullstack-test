generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Investment {
  id             Int      @id @default(autoincrement())
  owner          String
  amount         Decimal     @db.Decimal(15, 2)
  createdAt      DateTime
  withdrawalDate DateTime?
  updatedAt      DateTime    @updatedAt
}